{
  "name": "type4me-desktop",
  "version": "1.0.0",
  "description": "Type4Me Desktop: Windows AI Voice Prompt Suite & Accent-Aware Context Engine",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable",
    "test": "node --test tests/**/*.test.mjs"
  },
  "build": {
    "appId": "com.transcriptor.type4me.desktop",
    "productName": "Type4Me Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "dir"
      ]
    }
  },
  "keywords": [
    "voice-prompt",
    "ai-agent",
    "speech-to-text",
    "accent-calibration",
    "windows-h",
    "gemini-3.7-flash",
    "transcribe"
  ],
  "author": "KoueKoffie-MW",
  "license": "ISC",
  "dependencies": {
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
