<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ================================================================= -->
    <!-- Bluetooth Permissions (Android 12+ / API 31+)                     -->
    <!-- ================================================================= -->
    <!-- Required to connect to paired Bluetooth hosts (HID Device profile) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Required to make the Android phone discoverable as an HID keyboard -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Required for scanning nearby host PCs to initiate pairing -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- ================================================================= -->
    <!-- Legacy Bluetooth Permissions (Android 9-11 / API 28-30)           -->
    <!-- ================================================================= -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- ================================================================= -->
    <!-- Foreground Service Permissions (Android 14+ / API 34+ Enforced)   -->
    <!-- ================================================================= -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Post Notifications (Android 13+ / API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock during high-speed typing bursts -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Internet & Network State for Gemini API Rewriting -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Battery optimization exemption for background typing -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Optical Screen Lens & OCR Snapshot (Zero-Host Context Ingestion) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Continuous Audio & Push-To-Talk -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".TranscriptorApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.TranscriptorHID"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TranscriptorHID"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================================= -->
        <!-- Foreground Service Declaration with connectedDevice Type      -->
        <!-- ============================================================= -->
        <service
            android:name=".service.HidDeviceService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
